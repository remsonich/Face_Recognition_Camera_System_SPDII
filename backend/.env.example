# =======================================================
# Database Configuration
# =======================================================
# 1. Local SQLite (Default):
# DATABASE_URL=sqlite:///./sql_app.db
#
# 2. Supabase PostgreSQL (Cloud Database):
# Copy your URI from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Example (Session/Transaction Pooler):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# =======================================================
# Telegram Intruder Alert Configuration
# =======================================================
# 1. Create a bot with @BotFather on Telegram to get your BOT TOKEN
# 2. Get your CHAT ID from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_COOLDOWN_SECONDS=30
